{
  "name": "atriarch-tracery",
  "private": true,
  "version": "0.0.0",
  "description": "Tracery: agent activity graphs. Event contract, reducers, React visualizer, emitter SDKs and a standalone hub server.",
  "type": "module",
  "workspaces": [
    "packages/visualizer",
    "packages/core",
    "packages/client",
    "packages/react",
    "apps/hub",
    "apps/hub/web",
    "examples/embedded"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:plugin": "node --test plugins/claude-code/tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "node scripts/demo.mjs"
  },
  "engines": { "node": ">=22.13" },
  "devDependencies": { "typescript": "^5.6.0" }
}
