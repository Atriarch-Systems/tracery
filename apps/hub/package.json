{
  "name": "@atriarch/tracery-hub",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Tracery standalone hub server: ingest, storage, retention, live feed and hosted UI.",
  "type": "module",
  "funding": { "type": "ko-fi", "url": "https://ko-fi.com/demonslyr" },
  "bin": {
    "tracery-hub": "./bin/hub.mjs"
  },
  "files": [
    "dist",
    "bin",
    "ee/dist",
    "ee/LICENSE",
    "ee/scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ee",
    "build:ee": "tsc -b ee/tsconfig.json",
    "test": "node --test tests/*.test.mjs && npm run test:ee",
    "test:ee": "node --test ee/tests/*.test.mjs",
    "start": "node bin/hub.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@atriarch/tracery-core": "*",
    "@fastify/static": "^8",
    "@fastify/swagger": "^9",
    "@fastify/websocket": "^11",
    "fastify": "^5",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8",
    "@types/ws": "^8",
    "typescript": "^5.6.0",
    "ws": "^8"
  }
}
