{
  "name": "@atriarch/tracery-hub",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Tracery standalone hub server: ingest, storage, retention, live feed and hosted UI.",
  "type": "module",
  "funding": { "type": "ko-fi", "url": "https://ko-fi.com/demonslyr" },
  "bin": {
    "tracery-hub": "./bin/hub.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./auth": { "types": "./dist/auth.d.ts", "import": "./dist/auth.js" },
    "./store": { "types": "./dist/store/types.d.ts", "import": "./dist/store/types.js" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js" },
    "./test-helpers": { "types": "./dist/test-helpers.d.ts", "import": "./dist/test-helpers.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "start": "node bin/hub.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@atriarch/tracery-core": "*",
    "@fastify/static": "^8",
    "@fastify/swagger": "^9",
    "@fastify/websocket": "^11",
    "fastify": "^5",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8",
    "@types/ws": "^8",
    "typescript": "^5.6.0",
    "ws": "^8"
  }
}
