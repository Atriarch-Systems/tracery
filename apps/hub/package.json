{
  "name": "@atriarch/activity-hub",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Atriarch Activity standalone hub server: ingest, storage, retention, live feed and hosted UI.",
  "type": "module",
  "bin": {
    "activity-hub": "./bin/hub.mjs"
  },
  "files": ["dist", "bin", "ee/dist", "ee/LICENSE", "ee/scripts", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ee",
    "build:ee": "tsc -b ee/tsconfig.json",
    "test": "node --test tests/*.test.mjs && npm run test:ee",
    "test:ee": "node --test ee/tests/*.test.mjs",
    "start": "node bin/hub.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@atriarch/activity-core": "*",
    "@fastify/static": "^8",
    "@fastify/swagger": "^9",
    "@fastify/websocket": "^11",
    "fastify": "^5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/ws": "^8",
    "typescript": "^5.6.0",
    "ws": "^8"
  }
}
